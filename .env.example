# Names only. Deployed values belong in Worker Secrets, never Vite variables.
# Local Wrangler uses .dev.vars; copy names there and keep it ignored.
OWNER_EMAIL=
# Vercel private storage and backend proxy (server-side only)
MONGODB_URI=
MONGODB_DATABASE=shortlist
MONGO_STORAGE_SECRET=
SHORTLIST_BACKEND_URL=
DEPLOYMENT_PROXY_SECRET=
# Worker owner sessions
OWNER_SESSION_SECRET=
OWNER_PASSWORD_HASH=
FREEHIRE_API_KEY=
# Phase 2
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional AI provider, later phase; select model during implementation.
OPENAI_API_KEY=
# Phase 5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
